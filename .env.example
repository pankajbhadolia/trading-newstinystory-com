# PostgreSQL connection string. Replace with your own local or hosted database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/traders_command_centre?schema=public"
# For Supabase use the Dashboard's session pooler URL with ?schema=trader_app&sslmode=require.
# Use an unexposed private schema; do not put database credentials in NEXT_PUBLIC_ variables.

# Generate a random secret of at least 32 characters. Use HTTPS in production.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Set true only behind a trusted proxy that overwrites X-Real-IP and blocks direct access.
AUTH_TRUST_PROXY_IP="false"

# SMTP uses implicit TLS when true; otherwise STARTTLS is required.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASSWORD=""

# Optional UTC timestamp. Existing preview accounts keep Pro-level access until this time.
# If unset, existing preview access is retained indefinitely.
LEGACY_ACCESS_UNTIL=""
